rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // DEVELOPMENT RULES: open on purpose so the dashboard works without auth.
    // Lock down before launch: require request.auth.uid to match
    // resource.data.owner_uid on /groups/{chatId}. See README -> "Locking down Firestore".
    match /groups/{chatId} {
      allow read, write: if true;
    }
  }
}
