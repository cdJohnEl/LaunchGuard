# Copy to .env and fill in. Never commit .env.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Public HTTPS base URL of this server (no trailing slash). Required for webhooks.
WEBHOOK_URL=https://your-domain.example
# Secret Telegram echoes back in X-Telegram-Bot-Api-Secret-Token. Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=pick-a-long-random-string
# Option A: path to the Firebase service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json
# Option B: the full service account JSON as one string (useful on Railway/Render)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# LLM provider for tier 2: mock (default) | claude_cli
LAUNCHGUARD_LLM_PROVIDER=mock
LLM_TIMEOUT_SECONDS=10
